// =================================
// DLS CARD GENERATOR
// =================================
 function DLS_Check(input) {
    if (!DLS_SETTINGS.enabled) return;
    const playerInput = input.toLowerCase();
    for (const card of DLS_CARDS) {

        // Prepare the normal Story Card triggers.
        const cardKeys = card.triggers.join(", ");

        // Check normal triggers.
        const matched = card.triggers.some(trigger =>
            playerInput.includes(trigger.toLowerCase())
        );

        // Check additional reveal triggers.
        const revealMatches = (card.revealTriggers || []).filter(trigger =>
            playerInput.includes(trigger.toLowerCase())
        );

        // Find an existing Story Card.
        const existingIndex = storyCards.findIndex(existing =>
            existing.title === card.name ||
            existing.keys === cardKeys
        );

        // =================================
        // EXISTING STORY CARD
        // =================================
        if (existingIndex !== -1) {
            // Start with the short triggers.
            let updatedKeys = cardKeys;
            // Temporarily add any matching reveal triggers.
            if (revealMatches.length > 0) {
                updatedKeys += ", " + revealMatches.join(", ");
            }
            // Update the existing Story Card.
            updateStoryCard(
                existingIndex,
                updatedKeys,
                card.entry,
                card.type,
                card.name,
                card.notes
            );
            if (revealMatches.length > 0) {
                log("DLS: Revealed " + card.name);
            }
            continue;
        }
        // =================================
        // NEW STORY CARD FUNCTION
        // =================================
        // No matching keyword? Skip this card.
        if (!matched && revealMatches.length === 0) continue;
        // If a reveal trigger matched, include it in the
        // new card's keys so it can activate immediately.
        let newKeys = cardKeys;
        if (revealMatches.length > 0) {
            newKeys += ", " + revealMatches.join(", ");
        }
        // Create the Story Card.
        addStoryCard(
            newKeys,
            card.entry,
            card.type,
            card.name,
            card.notes
        );
        log("DLS: Created " + card.name);
    }
}
